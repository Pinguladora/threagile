              {
                "required": [
                  "technologies"
                ]
              }
            ]
          }
        ],
        "properties": {
          "availability": {
            "description": "Indicates how critical it is for the technical asset to be accessible and operational when needed, helping assess risks related to downtime or service interruptions.",
            "enum": [
              "archive",
              "operational",
              "important",
              "critical",
              "mission-critical"
            ],
            "type": "string"
          },
          "communication_links": {
