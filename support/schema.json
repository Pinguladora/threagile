                "authentication": {
                  "description": "Authentication",
                  "enum": [
                    "none",
                    "credentials",
                    "session-id",
                    "token",
                    "client-certificate",
                    "two-factor",
                    "externalized"
                  ],
                  "type": "string"
                },
                "authorization": {
                  "description": "Authorization (Threagile also reads enduser-identity-propagation, the spelling of releases up to 0.9, as end-user-identity-propagation)",
                  "enum": [
                    "none",
